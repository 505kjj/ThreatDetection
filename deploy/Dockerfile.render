FROM eclipse-temurin:21-jdk-jammy@sha256:b2711c65970c1227197c29c46e669bfdbb137524e9da0e664703a140ec25a040 AS build
WORKDIR /source
COPY backend/ backend/
COPY extension/theme.css extension/theme.css
COPY extension/icons/mark.svg extension/icons/mark.svg
COPY extension/fonts/ extension/fonts/
RUN cd backend && sh mvnw -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre-jammy@sha256:a8bff88f760e87e0c8844f8461f807c203fd5e8f78c951c843024647e965eaf5
WORKDIR /app
COPY --from=build /source/backend/target/threat-detection-0.0.1-SNAPSHOT.jar app.jar
COPY deploy/render-jvm.options jvm.options
RUN test -r /etc/ssl/certs/ca-certificates.crt
USER 10001:1000
EXPOSE 10000
ENTRYPOINT ["java", "@/app/jvm.options", "-jar", "/app/app.jar"]
