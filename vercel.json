{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node website/build.mjs --vercel",
  "outputDirectory": "website/dist",
  "git": { "deploymentEnabled": false },
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
      },
      "continue": true
    },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/(features|how-it-works|research|extension|demo|privacy|docs|faq|administrator)/?$", "dest": "/$1/index.html" },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
